import { Image, Pressable, StyleSheet, Text, View } from 'react-native';
import { defaultMoodStyle, moodStyles } from '../constants/moodStyles';
import { COLORS, RADIUS, SPACE, TYPO } from '../styles/tokens';

export default function DiaryCard({
  title,
  date,
  preview,
  image,
  moodUri,
  mood,
  onPress,
  variant = 'list',
}) {
  const theme = moodStyles[mood] ?? defaultMoodStyle;
  const source = image ?? { uri: moodUri };

  return (
    <Pressable
      onPress={onPress}
      style={({ pressed }) => [
        styles.card,
        {
          borderColor: theme.borderColor,
          backgroundColor: theme.backgroundColor,
          borderWidth: theme.borderWidth,
          borderLeftWidth: theme.borderWidth + theme.accentWidth,
        },
        variant === 'grid' && styles.cardGrid,
        { opacity: pressed ? 0.85 : 1 },
      ]}
      accessible
      accessibilityLabel={`Entri ${title} tanggal ${date}`}
    >
      <Image source={source} style={[styles.mood, { borderColor: theme.borderColor }]} />
      <View style={styles.content}>
        <Text style={styles.title}>{title}</Text>
        <Text style={styles.date}>{date}</Text>
        <Text style={styles.preview}>{preview}</Text>
        <Text style={[styles.badge, { color: theme.borderColor }]}>{theme.label}</Text>
      </View>
    </Pressable>
  );
}

const styles = StyleSheet.create({

  cardGrid: {},
  mood: {
    width: 64,
    height: 64,
    borderRadius: RADIUS.avatar,
    borderWidth: 2,
    backgroundColor: COLORS.border,
  },
  content: { flex: 1 },
  title: { fontSize: TYPO.title, fontWeight: '700', color: COLORS.text },
  date: { fontSize: TYPO.caption, color: COLORS.muted, marginBottom: SPACE.s },
  preview: { fontSize: TYPO.body, color: COLORS.text },
  badge: { marginTop: SPACE.s, fontSize: TYPO.caption, fontWeight: '700' },
});